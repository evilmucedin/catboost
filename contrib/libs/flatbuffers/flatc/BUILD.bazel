load("@rules_cc//cc:defs.bzl", "cc_library", "cc_binary", "cc_test", "cc_import")

# flatc — FlatBuffers schema compiler (host tool).
# Used as a build-time code generator for .fbs schema files.

cc_binary(
    name = "flatc",
    srcs = [],
    deps = [
        "//contrib/libs/flatbuffers:flatc_src",
    ],
    copts = [
        "-DFLATBUFFERS_LOCALE_INDEPENDENT=1",
        "-Wno-everything",
    ],
    linkopts = select({
        "@platforms//os:macos": ["-framework CoreFoundation"],
        "//conditions:default": [],
    }),
    visibility = ["//visibility:public"],
)
