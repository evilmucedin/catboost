load("@rules_cc//cc:defs.bzl", "cc_library", "cc_binary", "cc_test", "cc_import")

# POSIX/C-library compatibility shims for platforms missing certain functions.

cc_library(
    name = "libc_compat",
    srcs = [
        "explicit_bzero.c",
        "memrchr.c",
        "reallocarray/reallocarray.c",
        "string.c",
    ],
    hdrs = glob(
        ["*.h", "include/*.h"],
        allow_empty = True,
    ),
    includes = ["."],
    strip_include_prefix = ".",
    include_prefix = "contrib/libs/libc_compat",
    visibility = ["//visibility:public"],
    copts = select({
        "@platforms//os:windows": [],
        "//conditions:default": ["-Wno-deprecated-declarations"],
    }),
)
