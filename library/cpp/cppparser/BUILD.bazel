load("@rules_cc//cc:defs.bzl", "cc_library", "cc_binary", "cc_test", "cc_import")

# Simple C++ declaration parser used by the enum_parser tool.

cc_library(
    name = "cppparser",
    srcs = glob(
        ["*.cpp"],
        exclude = ["**/*_ut*.cpp"],
    ),
    hdrs = glob(["*.h"]),
    deps = ["//util"],
    visibility = ["//visibility:public"],
)
